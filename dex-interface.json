  "examples": [
    {
      "name": "discover_and_quote",
      "description": "Resolve a canonical pair and quote a route for the same signer that may submit it.",
      "steps": [
        {"interaction": "read", "contract": "con_pairs", "function": "pairFor", "arguments": {"tokenA": "currency", "tokenB": "demo_token"}, "save_as": "pair"},
        {"interaction": "read", "contract": "con_pairs", "function": "getReserves", "arguments": {"pair": "$pair"}, "save_as": "reserves"},
        {"interaction": "read", "contract": "con_dex", "function": "getAmountsOut", "arguments": {"amountIn": 10, "src": "currency", "path": ["$pair"]}, "save_as": "amounts"}
      ]
    },
    {
      "name": "swap_exact_input",
      "description": "Approve the input token, refresh the quote, derive a minimum, then submit with an absolute deadline.",
      "steps": [
        {"interaction": "write", "contract": "$input_token", "function": "approve", "arguments": {"amount": "$amountIn", "to": "con_dex"}},
        {"interaction": "read", "contract": "con_dex", "function": "getAmountsOut", "arguments": {"amountIn": "$amountIn", "src": "$input_token", "path": "$path"}, "save_as": "amounts"},
        {"interaction": "write", "contract": "con_dex", "function": "swapExactTokensForTokens", "arguments": {"amountIn": "$amountIn", "amountOutMin": "$risk_adjusted_minimum", "path": "$path", "src": "$input_token", "to": "$signer", "deadline": "$absolute_deadline"}}
      ]
    },
    {
      "name": "swap_fee_on_transfer",
      "description": "Use the supporting route when the input or final output token is owner-flagged as fee-on-transfer.",
      "steps": [
        {"interaction": "write", "contract": "$input_token", "function": "approve", "arguments": {"amount": "$amountIn", "to": "con_dex"}},
        {"interaction": "write", "contract": "con_dex", "function": "swapExactTokensForTokensSupportingFeeOnTransferTokens", "arguments": {"amountIn": "$amountIn", "amountOutMin": "$risk_adjusted_minimum", "path": "$path_without_flagged_bridge_tokens", "src": "$input_token", "to": "$signer", "deadline": "$absolute_deadline"}}
      ]
    },
    {
      "name": "add_liquidity",
      "description": "Approve both tokens and submit desired and minimum amounts after confirming LP-token registration.",
      "steps": [
        {"interaction": "read", "contract": "con_pairs", "function": "registeredLpTokenFor", "arguments": {"tokenA": "$tokenA", "tokenB": "$tokenB"}, "save_as": "lpToken"},
        {"interaction": "write", "contract": "$tokenA", "function": "approve", "arguments": {"amount": "$amountADesired", "to": "con_dex"}},
        {"interaction": "write", "contract": "$tokenB", "function": "approve", "arguments": {"amount": "$amountBDesired", "to": "con_dex"}},
        {"interaction": "write", "contract": "con_dex", "function": "addLiquidity", "arguments": {"tokenA": "$tokenA", "tokenB": "$tokenB", "amountADesired": "$amountADesired", "amountBDesired": "$amountBDesired", "amountAMin": "$amountAMin", "amountBMin": "$amountBMin", "to": "$signer", "deadline": "$absolute_deadline", "lpToken": "$lpToken"}}
      ]
    },
    {
      "name": "remove_liquidity",
      "description": "Approve the bound LP token to con_dex and enforce minimum amounts for both assets.",
      "steps": [
        {"interaction": "read", "contract": "con_pairs", "function": "pairFor", "arguments": {"tokenA": "$tokenA", "tokenB": "$tokenB"}, "save_as": "pair"},
        {"interaction": "read", "contract": "con_pairs", "function": "lpTokenFor", "arguments": {"pair": "$pair"}, "save_as": "lpToken"},
        {"interaction": "write", "contract": "$lpToken", "function": "approve", "arguments": {"amount": "$liquidity", "to": "con_dex"}},
        {"interaction": "write", "contract": "con_dex", "function": "removeLiquidity", "arguments": {"tokenA": "$tokenA", "tokenB": "$tokenB", "liquidity": "$liquidity", "amountAMin": "$amountAMin", "amountBMin": "$amountBMin", "to": "$signer", "deadline": "$absolute_deadline"}}
      ]
    }
  ]
}
