        {"name": "change_metadata", "interaction": "write", "arguments": [{"name": "key", "type": "str", "required": true}, {"name": "value", "type": "Any", "required": true}], "returns": "null", "safety": ["metadata_access"]},
        {"name": "get_metadata", "interaction": "read", "arguments": [], "returns": "object", "safety": []},
        {"name": "balance_of", "interaction": "read", "arguments": [{"name": "address", "type": "str", "required": true}], "returns": "float", "safety": []},
        {"name": "allowance", "interaction": "read", "arguments": [{"name": "owner", "type": "str", "required": true}, {"name": "spender", "type": "str", "required": true}], "returns": "float", "safety": []},
        {"name": "transfer", "interaction": "write", "arguments": [{"name": "amount", "type": "float", "required": true}, {"name": "to", "type": "str", "required": true}], "returns": "null", "safety": []},
        {"name": "approve", "interaction": "write", "arguments": [{"name": "amount", "type": "float", "required": true}, {"name": "to", "type": "str", "required": true}], "returns": "null", "safety": ["approval_required"]},
